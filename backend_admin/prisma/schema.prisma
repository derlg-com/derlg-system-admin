generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                  @id @default(uuid()) @db.Uuid
  supabase_uid            String                  @unique
  email                   String                  @unique
  role                    user_role               @default(user)
  preferred_language      supported_language      @default(en)
  full_name               String?
  phone                   String?
  avatar_url              String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  loyalty_points          Int                     @default(0)
  is_student_verified     Boolean                 @default(false)
  referral_code           String?                 @unique
  referred_by             String?                 @db.Uuid
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  ai_chat_sessions        ai_chat_sessions[]
  audit_logs              AuditLog[]
  bookings                Booking[]
  emergency_alerts        EmergencyAlert[]
  favorites               favorites[]
  location_shares         location_shares[]
  loyalty_transactions    loyalty_transactions[]
  notifications           notifications[]
  payments                payments[]
  push_device_tokens      push_device_tokens[]
  reviews                 reviews[]
  student_verifications   student_verifications[]

  @@map("users")
}

model Booking {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String          @map("user_id") @db.Uuid
  reference            String          @unique
  start_date           DateTime        @db.Date
  end_date             DateTime?       @db.Date
  status               booking_status  @default(reserved)
  expires_at           DateTime        @db.Timestamptz(6)
  subtotal_usd         Decimal         @db.Decimal(10, 2)
  discount_usd         Decimal         @default(0) @db.Decimal(10, 2)
  loyalty_discount_usd Decimal         @default(0) @db.Decimal(10, 2)
  totalUsd             Decimal         @map("total_usd") @db.Decimal(10, 2)
  cancelled_at         DateTime?       @db.Timestamptz(6)
  cancel_reason        String?
  refund_percentage    Int?
  qr_code_url          String?
  passenger_count      Int             @default(1)
  room_count           Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking_items        booking_items[]
  users                User            @relation(fields: [userId], references: [id])
  notifications        notifications[]
  payments             payments[]

  @@index([createdAt])
  @@index([expires_at])
  @@index([start_date])
  @@index([status])
  @@index([userId])
  @@map("bookings")
}

model TransportationVehicle {
  id            String          @id @default(uuid()) @db.Uuid
  vehicle_type  vehicle_type
  name          String
  license_plate String?
  capacity      Int             @default(4)
  pricing_model pricing_model
  price_usd     Decimal         @db.Decimal(10, 2)
  province      String
  images        String[]        @default([])
  is_active     Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking_items booking_items[]

  @@index([is_active])
  @@index([province])
  @@index([vehicle_type])
  @@map("transportation_vehicles")
}

model AuditLog {
  id          String           @id @default(uuid()) @db.Uuid
  user_id     String?          @db.Uuid
  event_type  audit_event_type
  entity_type String
  entity_id   String?          @db.Uuid
  ipAddress   String?          @map("ip_address")
  userAgent   String?          @map("user_agent")
  metadata    Json?
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  users       User?            @relation(fields: [user_id], references: [id])

  @@index([created_at])
  @@index([entity_type, entity_id])
  @@index([event_type])
  @@index([user_id])
  @@map("audit_logs")
}

model EmergencyAlert {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  alertType       emergency_alert_type   @map("alert_type")
  status          emergency_alert_status @default(triggered)
  latitude        Decimal                @db.Decimal(10, 7)
  longitude       Decimal                @db.Decimal(10, 7)
  accuracy_meters Decimal?               @db.Decimal(7, 2)
  acknowledged_at DateTime?              @db.Timestamptz(6)
  acknowledged_by String?                @db.Uuid
  resolved_at     DateTime?              @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  driverId        String?                @map("driver_id") @db.Uuid
  driver          Driver?                @relation(fields: [driverId], references: [id])
  users           User                   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([alertType])
  @@map("emergency_alerts")
}

model ai_chat_messages {
  id               String           @id @db.Uuid
  session_id       String           @db.Uuid
  role             String
  content          String
  message_type     String           @default("text")
  metadata         Json?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  ai_chat_sessions ai_chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at])
}

model ai_chat_sessions {
  id               String             @id @db.Uuid
  user_id          String             @db.Uuid
  title            String?
  is_active        Boolean            @default(true)
  language         supported_language @default(en)
  last_message_at  DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  ai_chat_messages ai_chat_messages[]
  users            User               @relation(fields: [user_id], references: [id])

  @@index([last_message_at])
  @@index([user_id])
}

model booking_items {
  id                      String                 @id @db.Uuid
  booking_id              String                 @db.Uuid
  booking_type            booking_type
  trip_id                 String?                @db.Uuid
  hotel_room_id           String?                @db.Uuid
  vehicle_id              String?                @db.Uuid
  guide_id                String?                @db.Uuid
  date                    DateTime               @db.Date
  quantity                Int                    @default(1)
  unit_price_usd          Decimal                @db.Decimal(10, 2)
  subtotal_usd            Decimal                @db.Decimal(10, 2)
  bookings                Booking                @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  guides                  guides?                @relation(fields: [guide_id], references: [id])
  hotel_rooms             hotel_rooms?           @relation(fields: [hotel_room_id], references: [id])
  trips                   trips?                 @relation(fields: [trip_id], references: [id])
  transportation_vehicles TransportationVehicle? @relation(fields: [vehicle_id], references: [id])

  @@index([booking_id])
  @@index([booking_type])
  @@index([date])
  @@index([guide_id])
  @@index([hotel_room_id])
  @@index([trip_id])
  @@index([vehicle_id])
}

model discount_codes {
  id              String        @id @db.Uuid
  code            String        @unique
  discount_type   discount_type
  value           Decimal       @db.Decimal(10, 2)
  max_uses        Int?
  current_uses    Int           @default(0)
  min_booking_usd Decimal?      @db.Decimal(10, 2)
  valid_from      DateTime      @db.Timestamptz(6)
  valid_until     DateTime      @db.Timestamptz(6)
  is_active       Boolean       @default(true)
  festival_id     String?       @db.Uuid
  booking_type    booking_type?
  user_id         String?       @db.Uuid
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  festivals       festivals?    @relation(fields: [festival_id], references: [id])

  @@index([code])
  @@index([is_active])
  @@index([valid_from, valid_until])
}

model emergency_contacts {
  id           String   @id @db.Uuid
  province     String
  service_name String
  phone        String
  address      String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([province, service_name])
  @@index([province])
}

model exchange_rates {
  id            String   @id @db.Uuid
  from_currency String
  to_currency   String
  rate          Decimal  @db.Decimal(12, 6)
  fetched_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([from_currency, to_currency])
  @@index([fetched_at])
}

model favorites {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  trip_id    String?  @db.Uuid
  hotel_id   String?  @db.Uuid
  place_id   String?  @db.Uuid
  guide_id   String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  guides     guides?  @relation(fields: [guide_id], references: [id], onDelete: Cascade)
  hotels     hotels?  @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  places     places?  @relation(fields: [place_id], references: [id], onDelete: Cascade)
  trips      trips?   @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, guide_id])
  @@unique([user_id, hotel_id])
  @@unique([user_id, place_id])
  @@unique([user_id, trip_id])
}

model festival_translations {
  id          String             @id @db.Uuid
  festival_id String             @db.Uuid
  language    supported_language
  name        String
  description String?
  location    String?
  festivals   festivals          @relation(fields: [festival_id], references: [id], onDelete: Cascade)

  @@unique([festival_id, language])
  @@index([festival_id])
}

model festivals {
  id                    String                  @id @db.Uuid
  start_date            DateTime                @db.Date
  end_date              DateTime                @db.Date
  province              String?
  images                String[]                @default([])
  is_published          Boolean                 @default(false)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @db.Timestamptz(6)
  discount_codes        discount_codes[]
  festival_translations festival_translations[]

  @@index([start_date, end_date])
}

model guide_languages {
  id       String             @id @db.Uuid
  guide_id String             @db.Uuid
  language supported_language
  guides   guides             @relation(fields: [guide_id], references: [id], onDelete: Cascade)

  @@unique([guide_id, language])
}

model guide_specialities {
  id         String @id @db.Uuid
  guide_id   String @db.Uuid
  speciality String
  guides     guides @relation(fields: [guide_id], references: [id], onDelete: Cascade)

  @@unique([guide_id, speciality])
}

model guides {
  id                 String               @id @db.Uuid
  user_id            String               @unique @db.Uuid
  bio                String?
  avatar_url         String?
  images             String[]             @default([])
  price_per_day_usd  Decimal              @db.Decimal(10, 2)
  is_verified        Boolean              @default(false)
  province           String
  provinces          String[]             @default([])
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @db.Timestamptz(6)
  booking_items      booking_items[]
  favorites          favorites[]
  guide_languages    guide_languages[]
  guide_specialities guide_specialities[]
  reviews            reviews[]

  @@index([is_active])
  @@index([is_verified])
  @@index([province])
}

model hotel_rooms {
  id            String          @id @db.Uuid
  hotel_id      String          @db.Uuid
  room_type     String
  max_occupancy Int             @default(2)
  price_usd     Decimal         @db.Decimal(10, 2)
  amenities     String[]        @default([])
  images        String[]        @default([])
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @db.Timestamptz(6)
  booking_items booking_items[]
  hotels        hotels          @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@index([hotel_id])
}

model hotel_translations {
  id          String             @id @db.Uuid
  hotel_id    String             @db.Uuid
  language    supported_language
  name        String
  address     String?
  description String?
  hotels      hotels             @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@unique([hotel_id, language])
  @@index([hotel_id])
}

model hotels {
  id                   String                 @id @db.Uuid
  latitude             Decimal                @db.Decimal(10, 7)
  longitude            Decimal                @db.Decimal(10, 7)
  star_rating          Int?
  images               String[]               @default([])
  amenities            String[]               @default([])
  is_published         Boolean                @default(false)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @db.Timestamptz(6)
  favorites            favorites[]
  hotel_rooms          hotel_rooms[]
  hotel_translations   hotel_translations[]
  reviews              reviews[]
  trip_itinerary_items trip_itinerary_items[]

  @@index([is_published])
}

model location_shares {
  id                      String    @id @db.Uuid
  user_id                 String    @db.Uuid
  share_token             String    @unique
  expires_at              DateTime  @db.Timestamptz(6)
  update_interval_minutes Int       @default(5)
  latitude                Decimal?  @db.Decimal(10, 7)
  longitude               Decimal?  @db.Decimal(10, 7)
  last_update_at          DateTime? @db.Timestamptz(6)
  is_active               Boolean   @default(true)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  users                   User      @relation(fields: [user_id], references: [id])

  @@index([expires_at])
  @@index([share_token])
  @@index([user_id])
}

model loyalty_transactions {
  id            String                   @id @db.Uuid
  user_id       String                   @db.Uuid
  type          loyalty_transaction_type
  points        Int
  balance_after Int
  booking_id    String?                  @db.Uuid
  reference     String?
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  users         User                     @relation(fields: [user_id], references: [id])

  @@index([booking_id])
  @@index([created_at])
  @@index([type])
  @@index([user_id])
}

model notifications {
  id            String               @id @db.Uuid
  user_id       String               @db.Uuid
  channel       notification_channel
  status        notification_status  @default(pending)
  title         String
  body          String?
  language      supported_language   @default(en)
  template_key  String?
  booking_id    String?              @db.Uuid
  metadata      Json?
  sent_at       DateTime?            @db.Timestamptz(6)
  delivered_at  DateTime?            @db.Timestamptz(6)
  read_at       DateTime?            @db.Timestamptz(6)
  error_message String?
  retry_count   Int                  @default(0)
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  bookings      Booking?             @relation(fields: [booking_id], references: [id])
  users         User                 @relation(fields: [user_id], references: [id])

  @@index([booking_id])
  @@index([channel])
  @@index([status])
  @@index([user_id, created_at])
}

model payments {
  id                       String           @id @db.Uuid
  booking_id               String           @db.Uuid
  user_id                  String           @db.Uuid
  provider                 payment_provider
  provider_payment_id      String?
  amount_usd               Decimal          @db.Decimal(10, 2)
  currency                 String           @default("usd")
  exchange_rate            Decimal?         @default(1.0) @db.Decimal(10, 6)
  status                   payment_status   @default(pending)
  refunded_amount_usd      Decimal          @default(0) @db.Decimal(10, 2)
  stripe_payment_intent_id String?
  client_secret            String?
  qr_code_url              String?
  qr_expires_at            DateTime?        @db.Timestamptz(6)
  idempotency_key          String?          @unique
  paid_at                  DateTime?        @db.Timestamptz(6)
  created_at               DateTime         @default(now()) @db.Timestamptz(6)
  updated_at               DateTime         @db.Timestamptz(6)
  bookings                 Booking          @relation(fields: [booking_id], references: [id])
  users                    User             @relation(fields: [user_id], references: [id])
  refunds                  refunds[]

  @@index([booking_id])
  @@index([provider])
  @@index([status])
  @@index([stripe_payment_intent_id])
  @@index([user_id])
}

model place_translations {
  id           String             @id @db.Uuid
  place_id     String             @db.Uuid
  language     supported_language
  name         String
  description  String?
  visitor_tips String?
  address      String?
  places       places             @relation(fields: [place_id], references: [id], onDelete: Cascade)

  @@unique([place_id, language])
  @@index([place_id])
}

model places {
  id                   String                 @id @db.Uuid
  category             place_category
  latitude             Decimal                @db.Decimal(10, 7)
  longitude            Decimal                @db.Decimal(10, 7)
  images               String[]               @default([])
  entry_fee_usd        Decimal?               @db.Decimal(10, 2)
  opening_hours        String?
  dress_code           String?
  website              String?
  is_published         Boolean                @default(false)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @db.Timestamptz(6)
  favorites            favorites[]
  place_translations   place_translations[]
  trip_itinerary_items trip_itinerary_items[]

  @@index([category])
  @@index([is_published])
}

model push_device_tokens {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  platform   String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model refresh_tokens {
  id         String    @id @db.Uuid
  token_id   String    @unique
  user_id    String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([expires_at])
  @@index([user_id])
}

model refunds {
  id                 String         @id @db.Uuid
  payment_id         String         @db.Uuid
  amount_usd         Decimal        @db.Decimal(10, 2)
  provider_refund_id String?
  reason             String
  percentage         Int
  status             payment_status @default(pending)
  processed_by_id    String?        @db.Uuid
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  payments           payments       @relation(fields: [payment_id], references: [id])

  @@index([payment_id])
}

model reviews {
  id                  String   @id @db.Uuid
  user_id             String   @db.Uuid
  trip_id             String?  @db.Uuid
  hotel_id            String?  @db.Uuid
  guide_id            String?  @db.Uuid
  rating              Int
  text                String?
  images              String[] @default([])
  is_verified_booking Boolean  @default(false)
  is_flagged          Boolean  @default(false)
  flag_reason         String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @db.Timestamptz(6)
  guides              guides?  @relation(fields: [guide_id], references: [id])
  hotels              hotels?  @relation(fields: [hotel_id], references: [id])
  trips               trips?   @relation(fields: [trip_id], references: [id])
  users               User     @relation(fields: [user_id], references: [id])

  @@index([guide_id])
  @@index([hotel_id])
  @@index([rating])
  @@index([trip_id])
  @@index([user_id])
}

model stripe_events {
  id              String   @id @db.Uuid
  stripe_event_id String   @unique
  event_type      String
  processed_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([stripe_event_id])
}

model student_verifications {
  id                String              @id @db.Uuid
  user_id           String              @db.Uuid
  id_card_image_url String
  selfie_image_url  String
  status            verification_status @default(pending)
  reviewed_by_id    String?             @db.Uuid
  review_notes      String?
  reviewed_at       DateTime?           @db.Timestamptz(6)
  expires_at        DateTime?           @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @db.Timestamptz(6)
  users             User                @relation(fields: [user_id], references: [id])

  @@index([status])
  @@index([user_id])
}

model trip_itinerary_item_translations {
  id                   String               @id @db.Uuid
  itinerary_item_id    String               @db.Uuid
  language             supported_language
  title                String
  description          String?
  trip_itinerary_items trip_itinerary_items @relation(fields: [itinerary_item_id], references: [id], onDelete: Cascade)

  @@unique([itinerary_item_id, language])
  @@index([itinerary_item_id])
}

model trip_itinerary_items {
  id                               String                             @id @db.Uuid
  trip_id                          String                             @db.Uuid
  day_number                       Int
  sort_order                       Int                                @default(0)
  place_id                         String?                            @db.Uuid
  hotel_id                         String?                            @db.Uuid
  trip_itinerary_item_translations trip_itinerary_item_translations[]
  hotels                           hotels?                            @relation(fields: [hotel_id], references: [id])
  places                           places?                            @relation(fields: [place_id], references: [id])
  trips                            trips                              @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id, day_number, sort_order])
}

model trip_translations {
  id                  String             @id @db.Uuid
  trip_id             String             @db.Uuid
  language            supported_language
  title               String
  subtitle            String?
  description         String?
  included_items      String[]           @default([])
  excluded_items      String[]           @default([])
  cancellation_policy String?
  meeting_point       String?
  trips               trips              @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@unique([trip_id, language])
  @@index([trip_id])
}

model trips {
  id                   String                 @id @db.Uuid
  category             trip_category
  duration_days        Int
  base_price_usd       Decimal                @db.Decimal(10, 2)
  max_capacity         Int                    @default(10)
  cover_image          String?
  images               String[]               @default([])
  is_published         Boolean                @default(false)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @db.Timestamptz(6)
  booking_items        booking_items[]
  favorites            favorites[]
  reviews              reviews[]
  trip_itinerary_items trip_itinerary_items[]
  trip_translations    trip_translations[]

  @@index([category])
  @@index([is_published])
}

model Driver {
  id                   String             @id @default(uuid()) @db.Uuid
  driverName           String             @map("driver_name") @db.VarChar(255)
  driverId             String             @unique @map("driver_id") @db.VarChar(50)
  telegramId           BigInt?            @unique @map("telegram_id")
  authPin              String             @map("auth_pin") @db.VarChar(255)
  phone                String             @db.VarChar(20)
  vehicleId            String?            @map("vehicle_id") @db.Uuid
  status               DriverStatus       @default(OFFLINE)
  preferredLanguage    String             @default("en") @map("preferred_language") @db.VarChar(5)
  lastStatusUpdate     DateTime           @default(now()) @map("last_status_update") @db.Timestamptz(6)
  lastTelegramActivity DateTime?          @map("last_telegram_activity") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments          DriverAssignment[]
  emergencyAlerts      EmergencyAlert[]
  supportTickets       SupportTicket[]

  @@index([telegramId])
  @@index([status])
  @@index([vehicleId])
  @@map("drivers")
}

model DriverAssignment {
  id                  String           @id @default(uuid()) @db.Uuid
  driverId            String           @map("driver_id") @db.Uuid
  bookingId           String           @map("booking_id") @db.Uuid
  vehicleId           String           @map("vehicle_id") @db.Uuid
  status              AssignmentStatus @default(PENDING)
  assignmentTimestamp DateTime         @default(now()) @map("assignment_timestamp") @db.Timestamptz(6)
  responseTimestamp   DateTime?        @map("response_timestamp") @db.Timestamptz(6)
  tripStartTime       DateTime?        @map("trip_start_time") @db.Timestamptz(6)
  completionTimestamp DateTime?        @map("completion_timestamp") @db.Timestamptz(6)
  rejectionReason     String?          @map("rejection_reason")
  telegramNotified    Boolean          @default(false) @map("telegram_notified")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  driver              Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([bookingId])
  @@index([status])
  @@index([driverId, completionTimestamp])
  @@map("driver_assignments")
}

model VehicleMaintenance {
  id               String            @id @default(uuid()) @db.Uuid
  vehicleId        String            @map("vehicle_id") @db.Uuid
  maintenanceType  String            @map("maintenance_type") @db.VarChar(100)
  scheduledDate    DateTime          @map("scheduled_date") @db.Date
  completionDate   DateTime?         @map("completion_date") @db.Date
  maintenanceCost  Decimal?          @map("maintenance_cost") @db.Decimal(10, 2)
  maintenanceNotes String?           @map("maintenance_notes")
  status           MaintenanceStatus @default(SCHEDULED)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
  @@map("vehicle_maintenance")
}

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  adminRole   AdminRole @map("admin_role")
  permissions Json?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([adminRole])
  @@map("admin_users")
}

model SupportTicket {
  id         String         @id @default(uuid()) @db.Uuid
  ticketId   String         @unique @map("ticket_id") @db.VarChar(20)
  driverId   String         @map("driver_id") @db.Uuid
  message    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(NORMAL)
  assignedTo String?        @map("assigned_to") @db.Uuid
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([status])
  @@map("support_tickets")
}

model BroadcastMessage {
  id           String          @id @default(uuid()) @db.Uuid
  messageId    String          @unique @map("message_id") @db.VarChar(50)
  content      String
  imageUrl     String?         @map("image_url") @db.VarChar(500)
  targetFilter Json            @map("target_filter")
  sentBy       String          @map("sent_by") @db.Uuid
  status       BroadcastStatus @default(PENDING)
  sentCount    Int             @default(0) @map("sent_count")
  failedCount  Int             @default(0) @map("failed_count")
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sentBy])
  @@index([status])
  @@map("broadcast_messages")
}

model Backup {
  id               String   @id @default(uuid()) @db.Uuid
  backupFileUrl    String   @map("backup_file_url")
  backupSizeBytes  BigInt?  @map("backup_size_bytes")
  createdByAdminId String   @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("backups")
}

